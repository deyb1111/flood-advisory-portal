+{% extends 'admin/_base.html' %}
+{% block title %}Administrator overview · Bantay Daan Pasig{% endblock %}
+{% block admin_content %}
+<div class="admin-page-head"><div><p class="admin-eyebrow">SYSTEM CONTROL</p><h1>Administrator overview</h1><p>Manage access, review administrative activity, and maintain system settings.</p></div></div>
+<div class="admin-stats">
+{% for label, value in [('Resident accounts', counts.residents), ('Personnel accounts', counts.personnel), ('Administrators', counts.admins), ('Inactive accounts', counts.inactive)] %}
